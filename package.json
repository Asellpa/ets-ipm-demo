{
  "name": "ets-integrated-project-management",
  "version": "2.0.0",
  "private": true,
  "description": "ETS departmental project, task, capacity and reporting application",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test:api": "node --test tests/*.test.cjs",
    "qa:react": "npm --prefix react run build && npm --prefix react run lint && npm run test:api",
    "test:e2e": "playwright test",
    "qa:full": "npm run qa:react && npm run test:e2e",
    "setup:demo": "node scripts/setup-demo.cjs",
    "db:migrate": "node production/scripts/database.cjs migrate",
    "db:import": "node production/scripts/database.cjs import",
    "db:verify": "node production/scripts/database.cjs verify",
    "test:production": "node --test tests/production*.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
